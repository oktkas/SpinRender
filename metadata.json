    "$schema": "https://go.kicad.org/pcm/schemas/v1",
    "identifier": "com.alsoknownasfoo.spinrender",
    "name": "SpinRender",
    "type": "plugin",
    "description": "KiCad plugin for generating animated PCB renders",
    "description_full": "SpinRender creates looping PCB renders directly from KiCad projects. Set zoom and X/Y framing in the live preview, save the setup as a preset, and export MP4, animated WebP, GIF, or PNG sequences. WebP, GIF, and PNG sequences support transparent backgrounds.",
